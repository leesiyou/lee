---
import ArticleCard from '@/components/ArticleCard.astro';
import { fetchPublishedArticles } from '@/lib/directus';
import { runtimeConfig } from '@/lib/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

const slug = Astro.params.slug ?? '';
const config = runtimeConfig();
if (!config.publicListingEnabled) Astro.response.status = 404;
const articles = config.publicListingEnabled
  ? (await fetchPublishedArticles({ apiUrl: config.directusInternalUrl, tag: slug, limit: 100 })).data
  : [];
---

<BaseLayout title="标签文章">
  {!config.publicListingEnabled && <section class="not-found"><p>UNLISTED MODE</p><h1>公开标签未启用。</h1><p>请使用作者分享的单篇链接。</p></section>}
  {config.publicListingEnabled && <>
  <section class="page-hero"><p>TAG</p><h1>#{slug}</h1></section>
  <section class="content-section">{articles.length ? <div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div> : <p class="empty-state">这个标签暂时没有已发布文章。</p>}</section></>}
</BaseLayout>
