---
import QRCode from 'qrcode';

import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildWechatMaterial } from '@/lib/content';
import { fetchPublishedArticle } from '@/lib/directus';
import {
  buildAssetUrl,
  buildWechatMaterialUrl,
  runtimeConfig,
} from '@/lib/routes';
import type { Article } from '@/lib/types';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const config = runtimeConfig();
const slug = Astro.params.slug ?? '';
let article: Article | null = null;
let unavailable = false;

try {
  article = await fetchPublishedArticle({ apiUrl: config.directusInternalUrl, slug });
} catch {
  unavailable = true;
  Astro.response.status = 503;
}

if (!article && !unavailable) Astro.response.status = 404;

const material = article ? buildWechatMaterial(article, `${config.publicBaseUrl}/`) : null;
const cover = article
  ? buildAssetUrl(article.wechat_cover || article.cover_image, config)
  : null;
const qrDataUrl = material
  ? await QRCode.toDataURL(material.qrContent, {
      errorCorrectionLevel: 'M',
      margin: 2,
      width: 640,
    })
  : null;
---

<BaseLayout
  canonical={buildWechatMaterialUrl(slug, config)}
  description={material?.summary || '公众号发布素材'}
  image={cover}
  title={material ? `${material.title}｜公众号素材` : '公众号素材'}
>
  {material ? (
    <article class="wechat-material">
      <header class="wechat-material__hero">
        <p class="eyebrow">公众号发布工作台</p>
        <h1>{material.title}</h1>
        <p>博客已经发布。这里的内容可以直接复制到公众号后台，最终发表仍由你人工确认。</p>
      </header>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>公众号标题</h2><button type="button" data-copy-target="wechat-title">复制标题</button></div>
        <p id="wechat-title" class="copy-source">{material.title}</p>
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>公众号摘要</h2><button type="button" data-copy-target="wechat-summary">复制摘要</button></div>
        <p id="wechat-summary" class="copy-source">{material.summary}</p>
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>封面</h2>{cover && <a href={cover} download>下载封面</a>}</div>
        {cover ? <img class="wechat-material__cover" src={cover} alt={material.title} /> : <p class="empty-state">这篇文章尚未设置封面，不影响复制文字素材。</p>}
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>3—5 段精华正文</h2><button type="button" data-copy-target="wechat-highlights">复制精华正文</button></div>
        <div id="wechat-highlights" class="copy-source wechat-material__highlights">
          {material.highlights.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>金句</h2><button type="button" data-copy-target="wechat-quote">复制金句</button></div>
        <blockquote id="wechat-quote" class="copy-source">{material.quote}</blockquote>
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>阅读原文地址</h2><button type="button" data-copy-target="wechat-source-url">复制链接</button></div>
        <p id="wechat-source-url" class="copy-source break-all">{material.sourceUrl}</p>
      </section>

      <section class="wechat-material__block">
        <div class="wechat-material__heading"><h2>朋友圈分享文案</h2><button type="button" data-copy-target="wechat-moments">复制朋友圈文案</button></div>
        <pre id="wechat-moments" class="copy-source">{material.momentsCopy}</pre>
      </section>

      <section class="wechat-material__block wechat-material__qr">
        <div class="wechat-material__heading"><h2>文章二维码</h2>{qrDataUrl && <a href={qrDataUrl} download={`${slug}-qrcode.png`}>下载二维码</a>}</div>
        {qrDataUrl && <img src={qrDataUrl} width="320" height="320" alt={`${material.title}二维码`} />}
      </section>

      <p class="wechat-material__notice" data-copy-status aria-live="polite">
        当前已生成公众号发布素材。自动写入公众号草稿箱功能尚未配置，不影响博客发布。
      </p>
    </article>
  ) : (
    <p class="standalone-error">{unavailable ? '内容服务暂时不可用，请稍后刷新。' : '文章不存在或尚未发布。'}</p>
  )}
</BaseLayout>

<script is:inline type="module" src="/scripts/wechat-material.js"></script>
