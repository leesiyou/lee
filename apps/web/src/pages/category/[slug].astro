---
import ArticleCard from '@/components/ArticleCard.astro';
import { fetchPublishedArticles } from '@/lib/directus';
import { runtimeConfig } from '@/lib/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

const slug = Astro.params.slug ?? '';
const articles = (await fetchPublishedArticles({ apiUrl: runtimeConfig().directusInternalUrl, category: slug, limit: 100 })).data;
---

<BaseLayout title="分类文章">
  <section class="page-hero"><p>CATEGORY</p><h1>分类 · {slug}</h1></section>
  <section class="content-section">{articles.length ? <div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div> : <p class="empty-state">这个分类暂时没有已发布文章。</p>}</section>
</BaseLayout>
